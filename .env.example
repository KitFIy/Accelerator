# Скопируйте в .env (файл .env в .gitignore — секреты в Git не попадают).

# --- Политика и режим ---
# AXISEC_POLICY=policies/crm_agent.yaml
# AXISEC_MODE=enforce                  # enforce | observe (наблюдение без блокировок)
# AXISEC_AUDIT_DB=data/audit.sqlite    # персистентный журнал аудита в SQLite

# --- Авторизация (для пилота / проды) ---
# AXISEC_ADMIN_TOKEN=change-me-admin-token
# AXISEC_GATEWAY_TOKENS={"agent-junior-key":"junior","agent-senior-key":"senior"}
# AXISEC_APPROVAL_WAIT_SECONDS=30

# --- Подключение реальной модели (раскомментируйте нужный блок) ---
# 1) OpenAI-совместимая модель:
# AXISEC_LLM_PROVIDER=openai
# AXISEC_LLM_UPSTREAM=https://api.openai.com/v1
# AXISEC_LLM_API_KEY=sk-...
# AXISEC_LLM_MODEL=gpt-4o-mini

# 2) GigaChat (Сбер):
# AXISEC_LLM_PROVIDER=gigachat
# AXISEC_LLM_UPSTREAM=https://api.giga.chat/v1
# AXISEC_GIGACHAT_AUTH_KEY=base64_client_id_colon_secret
# AXISEC_GIGACHAT_SCOPE=GIGACHAT_API_PERS
# AXISEC_LLM_MODEL=GigaChat-2-Pro
# AXISEC_LLM_CA_BUNDLE=/path/to/russian_trusted_root_ca.cer
# AXISEC_LLM_VERIFY_TLS=true

# 3) Yandex AI Studio (YandexGPT):
# AXISEC_LLM_PROVIDER=yandex
# AXISEC_LLM_UPSTREAM=https://llm.api.cloud.yandex.net/v1
# AXISEC_LLM_API_KEY=AQVN...
# AXISEC_YANDEX_FOLDER_ID=b1g...
# AXISEC_LLM_MODEL=yandexgpt

# --- Реальные MCP-серверы ---
# AXISEC_MCP_UPSTREAMS={"crm":"http://127.0.0.1:9000/mcp"}
